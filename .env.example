# Шаблон .env для front. Скопіюйте у ".env" (без ".example") і впишіть реальні значення.
# Файл читається ЛИШЕ при старті Vite — після змін перезапустіть "npm run dev".
# Покрокова інструкція: SETUP.md

VITE_MODE=dev

# Адреса back-сервера (порт 5000), БЕЗ "/" в кінці.
# Локально: http://localhost:5000
# У Codespaces: адреса виду https://xxxx-5000.app.github.dev (вкладка PORTS у Codespace бека)
VITE_LOCAL=http://localhost:5000
# Адреса самого front (порт 5173), аналогічно. Потрібна для деяких redirect-посилань.
VITE_LOCAL_FRONT=http://localhost:5173

# Лише для production-збірки (VITE_MODE=pro)
VITE_PRODUCTION=
VITE_PRODUCTION_FRONT=
VITE_DASHBOARD_PRODUCTION=

